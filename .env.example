# 服务端口（生产模式下前端与 API 共用一个端口）
PORT=5174
HOST=127.0.0.1

# SQLite 文件位置，默认 server/data/ka.db
# DB_PATH=./server/data/ka.db

# 本地 Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 单次 AI 分析的总时间预算（毫秒），默认 90000
AI_TIMEOUT_MS=90000

# 首次启动自动创建的管理员密码（不填则用 admin123，登录后请立即修改）
# DEFAULT_ADMIN_PASSWORD=改成你自己的密码
